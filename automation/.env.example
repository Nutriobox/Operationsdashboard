# Copy this file to ".env" and fill in your key. Never commit the real .env.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_ASSIST_MODEL=claude-sonnet-5

# Optional: put this in the repo's .env.local (not here) to make the ratings
# job pull Google ratings via the official Places API instead of scraping
# Google Search (which serves a /sorry bot-check). A Places "Text Search" key
# from Google Cloud Console works. Without it, ratings.py keeps each outlet's
# previous Google value each run.
# GOOGLE_PLACES_API_KEY=AIza...
