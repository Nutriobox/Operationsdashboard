# ---------------------------------------------------------------------------
# The jobs read their real secrets from the repo's existing .env.local
# (SUPABASE_*, GMAIL_*, GOOGLE_*) plus automation/secrets/{tokens.json,
# nutriobox-sa.json, browser-profile/}. COPY THOSE FROM THE LAPTOP — do not
# recreate them here.
#
# This file documents only the extra env the AWS bundle itself understands.
# You normally don't need to set any of these (defaults are fine).
# ---------------------------------------------------------------------------

# Where the repo lives on the server (must match cron/nutriobox-cron and run-job.sh)
REPO=/opt/nutriobox

# Where daily_data.py writes NutrioBox_Dashboard_*.html on the server.
# Set this to the actual output dir on the server (on the laptop it was
# C:\Users\hp\Downloads\NutrioBox_Reports). Used by bin/upload-dashboard.sh.
REPORTS_DIR=/opt/nutriobox/exports

# Timezone the cron times are interpreted in. Leave as IST.
CRON_TZ=Asia/Kolkata
